# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
# 이 파일을 복사해서 .env 로 만들고 실제 키를 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 깃허브에 올라가지 않습니다.
GEMINI_API_KEY=여기에_실제_API_키_붙여넣기

# 외국인(승객) 언어 BCP-47 코드. 기본값 ja(일본어).
# 예: ja(일본어), en(영어), zh-Hans(중국어 간체)
GUEST_LANGUAGE=ja

# 기사(자국) 언어. 기본값 ko(한국어).
HOST_LANGUAGE=ko

# 서버 포트
PORT=8000
